@startuml
!pragma layout smetana
skinparam defaultFontName Noto Serif CJK SC
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #334155
skinparam componentBackgroundColor #EFF6FF
skinparam stateBackgroundColor #EFF6FF
top to bottom direction
component "Cache / CacheReader / CacheWriter" as C
package "卷（Stripe）：Path、Skip、Len" {
  component "DirManager / DirTrie\n分段、桶、完整键映射\nDir：10 B，offset / approxSize / phase" as I
  component "RAM\nOtter 或 S3-FIFO\n不可变 Doc 片段" as R
  component "AggregateWriteBuffer\n2 × 4 MiB\n分配 offset / generation" as A
  artifact "数据文件中的卷区间" as D
  artifact "<Path>.<Skip>.checkpoint\n干净标记 / 卷布局 / 会话标识\n目录、键映射、写位置" as P
}
C --> I : 读：按对象键 CRC32 选卷\n片键 MD5 定位目录
I --> R : 目录有效后先查 RAM
I --> D : RAM 未命中：ReadAt(offset)\n先头、再完整片段
C --> A : 写：序列化片段
A --> D : 单个写入协程 / WriteAt\n按实际记录长度追加
C ..> I : 写入完成后复核围栏并发布\n第 0 片最后提交
C ..> R : 写入 / 元数据更新 / 迁移后填充
I ..> P : 排空关闭后保存目录与映射
D ..> P : 先同步数据，再发布干净检查点
note bottom of D
  Skip：24 B 会话标记
  目录保留区 + 512 B 边界填充
  Start：环形数据区
  [Doc 72 B | 元数据 | 正文] ...
  WritePos：已完成写入的尾部
  Skip + Len：区间末尾，放不下记录则回卷
  各片段可不连续、不保证逐条扇区对齐
end note
@enduml
