##############################################################################
# Bakemono Configuration File (records.config)
# Format: CONFIG <config_name> <type> <value>
# Similar to Apache Traffic Server records.config format
##############################################################################

# HTTP Server Configuration
CONFIG proxy.config.http.server_ports STRING 80

# PURGE is disabled unless a secret token is configured. Send Authorization: Bearer <token>.
# Keep records.config private; never put this token in URLs.
# Exact URL PURGE includes its query; a query-free trailing slash selects a URL prefix.
# CONFIG proxy.config.http.purge_token STRING replace-with-a-private-random-token

# Logging Configuration
CONFIG proxy.config.log.logfile_dir STRING /data/bakemono/logs
CONFIG proxy.config.log.access_log_filename STRING access.log
CONFIG proxy.config.log.error_log_filename STRING error.log

# Upstream Configuration
# TODO split to parent.config
CONFIG proxy.config.http.parent_proxy.upstream_algo STRING consistent-hash
CONFIG proxy.config.http.parent_proxy.upstream_targets STRING http://10.62.216.7,http://10.62.216.8

# Forwarded identity is ignored unless the direct peer is in these explicit CIDRs.
# CONFIG proxy.config.http.trusted_proxies STRING 192.0.2.0/24,2001:db8::/32

# Server Timeouts (in seconds)
CONFIG proxy.config.http.keep_alive_no_activity_timeout_in INT 120
CONFIG proxy.config.http.transaction_no_activity_timeout_in INT 30
CONFIG proxy.config.http.transaction_no_activity_timeout_out INT 30

# Phase deadlines, not a total download duration (seconds).
CONFIG proxy.config.http.request_header_timeout INT 10
CONFIG proxy.config.http.connect_timeout INT 5
CONFIG proxy.config.http.tls_handshake_timeout INT 5
CONFIG proxy.config.http.response_header_timeout INT 30
CONFIG proxy.config.http.queue_timeout INT 1
CONFIG proxy.config.http.shutdown_timeout INT 30

# Queues are bounded; zero queued capacity rejects immediately when busy.
CONFIG proxy.config.http.max_client_connections INT 512
CONFIG proxy.config.http.max_requests INT 256
CONFIG proxy.config.http.max_queued_requests INT 64
CONFIG proxy.config.http.max_origin_requests INT 64
CONFIG proxy.config.http.max_origin_queued_requests INT 32
CONFIG proxy.config.http.max_origin_connections INT 64
CONFIG proxy.config.cache.max_writers INT 16
CONFIG proxy.config.cache.max_queued_writers INT 16
# Cache per-write/commit deadline. Shared candidates fail if a write cannot finish.
CONFIG proxy.config.cache.write_timeout INT 5
# Writer reservation covers payload and bounded metadata; excludes RAM cache,
# stripe aggregate buffers, directory indexes and runtime (not a total RSS cap).
CONFIG proxy.config.cache.write_buffer_bytes INT 134217728
# Known larger responses stream only to the creator; unknown-length overflow fails.
CONFIG proxy.config.cache.max_object_bytes INT 67108864

# Whole-object sharing: followers read only after complete commit. Limits include
# the creator; private/no-store followers receive 503 without origin retries.
CONFIG proxy.config.cache.shared_fill_max_tasks INT 16
CONFIG proxy.config.cache.shared_fill_max_waiters INT 256
# Total producer lifetime in seconds, including private delivery; size this for large downloads.
CONFIG proxy.config.cache.shared_fill_timeout INT 300
